# PostgreSQL credentials (used by the db service)
POSTGRES_USER=slouch_admin
POSTGRES_PASSWORD=replace_me_with_a_strong_password
POSTGRES_DB=slouch_punisher
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full connection string for the Python/Gradio API
# When the API runs on the host, use `localhost`.
# When the API also runs in Docker on the same compose network, use `db`.
DATABASE_URL=postgresql://slouch_admin:replace_me_with_a_strong_password@localhost:5432/slouch_punisher

# Adminer (web UI for the database, http://localhost:8080)
ADMINER_PORT=8080